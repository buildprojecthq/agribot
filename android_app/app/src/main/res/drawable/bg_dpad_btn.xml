<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2610B981">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dpad_pressed" />
                    <stroke android:width="1.8dp" android:color="@color/dpad_stroke_pressed" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/dpad_normal" />
                    <stroke android:width="1.2dp" android:color="@color/dpad_stroke" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
